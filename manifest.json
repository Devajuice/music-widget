{
  "schemaVersion": 1,
  "id": "dj.music",
  "name": "Music",
  "version": "1.0.0",
  "author": "dj",
  "license": "MIT",
  "description": "Now-playing bar widget with album art, playback controls, and source switching over MPRIS",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Music",
    "description": "Now-playing track, album art popup, playback controls, and player/source switching",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "maxWidth": 220,
      "showArtist": true,
      "alwaysShow": false
    },
    "schema": [
      {
        "key": "maxWidth",
        "type": "integer",
        "label": "Maximum label width",
        "min": 60,
        "max": 600,
        "step": 10,
        "defaultValue": 220
      },
      {
        "key": "showArtist",
        "type": "boolean",
        "label": "Show artist next to track title",
        "defaultValue": true
      },
      {
        "key": "alwaysShow",
        "type": "boolean",
        "label": "Show the widget when a player has no metadata",
        "defaultValue": false
      }
    ]
  }
}
